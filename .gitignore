# ---------------------------------------------------------------------------
# DartScape .gitignore  (.NET Framework 4.0 / Visual Studio / XP builds)
# ---------------------------------------------------------------------------

# Build output
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
build/out/
*.exe.bak
*.pdb
*.mdb
*.ilk
*.exp
*.lib
*.cache
*.obj
*.tlog
*.lastbuildstate
*.idb
*.res
*.suo
*.user
*.userosscache
*.sln.docstates
*.csproj.user
*.DotSettings.user

# ---------------------------------------------------------------------------
# Live development instance (the top-level bin/ folder)
#
# build.cmd stages a ready-to-run server there: binaries, the cache, the web
# assets and a real config.ini. That whole folder is the working world, so none
# of it belongs in git -- only config.example.ini documents what a config looks
# like.
# ---------------------------------------------------------------------------
/bin/
/config.ini
/keys/
/launcher-data/
/data/accounts/
/data/characters/
/data/news.json
/data/*.tmp
/data/*.bak

# Visual Studio
.vs/
*.vspscc
*.vssscc
*.scc
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
*.VC.db
*.VC.opendb
.vscode/
.idea/

# NuGet (we use no third-party packages, but keep the folder out of git)
packages/
*.nupkg
nuget.exe
project.lock.json
project.assets.json

# Test / coverage
[Tt]est[Rr]esult*/
TestResults/
coverage/
*.coverage
*.coveragexml

# ReSharper / Rider
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings

# Runtime state that must never be committed
# (world saves, accounts, server logs, generated keys)
runtime/
data/accounts/
data/characters/
data/world/
logs/
*.log
!docs/**/*.log

# Secrets
*.pfx
*.key
*.snk
!assets/crypto/*.public.der
secrets/
secrets.json

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Local cache copies that are downloaded by tools/fetch-cache.ps1
# (the canonical 317 cache lives in assets/cache317 and IS committed)
assets/cache-download/

# ---------------------------------------------------------------------------
# Upstream reference sources (decompiled / third-party bases we study but do
# not redistribute). They stay on disk locally, they never enter the history.
# ---------------------------------------------------------------------------
/refs/
/refs-*/

